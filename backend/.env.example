JWT_REFRESH_SECRET=your_super_refresh_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Telegram Notification Bot (Ixtiyoriy)
TELEGRAM_BOT_TOKEN=
