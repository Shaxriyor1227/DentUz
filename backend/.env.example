# ===============================================================
# DentUz Backend — Muhit O'zgaruvchilari Namunalari (.env.example)
# ===============================================================

# 1. Server & Muhit
PORT=5000
NODE_ENV=production

# 2. CORS & Domenlar
# Productionda faqat rasmiy Vercel domeni va localhostga ruxsat beriladi (vergul bilan)
CORS_ORIGINS=https://dentuz.vercel.app,http://localhost:5173,http://localhost:3000
# Ixtiyoriy: Agar Vercel Preview URLlar kerak bo'lsa, loyiha prefiksi (masalan: dentuz-)
VERCEL_PREVIEW_PREFIX=dentuz-

# 3. Ma'lumotlar Bazasi (PostgreSQL)
# Render/Supabase/Neon uchun to'liq ulanish URL (yoki quyidagi alohida DB_* parametrlari)
DATABASE_URL=postgresql://username:password@db.supabase.co:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentuz
DB_USER=postgres
DB_PASSWORD=your_password_here

# 4. JWT Xavfsizlik Kalitlari (HAR BIRI KAMIDA 32 TA BELGIDAN IBORAT BO'LISHI SHART)
# Generatsiya qilish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_12345
JWT_REFRESH_SECRET=your_super_refresh_jwt_key_min_32_characters_long_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# 5. Tibbiy Fayllar Ombori (Storage Abstraction)
# Variantlar: 'supabase' (tavsiya etiladi), 's3', yoki 'local' (faqat lokal development uchun)
STORAGE_DRIVER=supabase
SUPABASE_URL=https://your-project-id.supabase.co
# DIQQAT: Faqat backendda ishlatiladigan PRIVATE service_role kaliti! (Anon kalit emas)
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key
STORAGE_BUCKET=medical-records

# 6. Telegram Bot Integratsiyasi
# Botni API serveridan mustaqil ishga tushirish (alohida jarayonda: npm run bot)
BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# 7. Swagger API Dokumentatsiyasi
# Productionda sukut bo'yicha o'chirilgan. Faqat Basic Auth bilan yoqish mumkin:
ENABLE_SWAGGER=false
SWAGGER_USER=dentuz_admin
SWAGGER_PASS=your_strong_swagger_password_min_12_chars
