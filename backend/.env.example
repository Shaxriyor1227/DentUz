PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Database Connection (PostgreSQL)
DB_NAME=dentuz
DB_USER=postgres
DB_PASSWORD=your_postgres_password
